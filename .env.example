# ===========================================================================
# Self-Hosted SMS Gateway - Environment Configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ===========================================================================

# --- Django core ------------------------------------------------------------
# Generate a strong value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Dev: True. Production: False.
DEBUG=False

# Comma-separated list of allowed hosts, e.g. "sms.example.com,api.example.com"
ALLOWED_HOSTS=*

# Comma-separated origins allowed for browser (CORS) requests, e.g. "https://app.example.com"
CORS_ALLOWED_ORIGINS=

# --- Admin panel -------------------------------------------------------------
# Secret path to the admin panel. Change this to hide the panel.
# Example: "control-room-xy9/" → accessible at https://yourdomain.com/control-room-xy9/
ADMIN_URL=admin/

# --- Database ---------------------------------------------------------------
# Leave empty to use the local SQLite file (db.sqlite3).
# For PostgreSQL:
DATABASE_URL=

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Uncomment only if they differ from REDIS_URL:
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- JWT --------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=7

# --- Security ---------------------------------------------------------------
# Force HTTPS redirect. Production should be True (works with nginx + TRUSTED_PROXY).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
# Set to True when serving behind nginx/Caddy that sends X-Forwarded-Proto.
TRUSTED_PROXY=False

# --- Webhooks ---------------------------------------------------------------
# Shared HMAC secret used to sign delivery attempts (X-HttpSMS-Signature).
WEBHOOK_SECRET=
# Timeout for each webhook delivery attempt (seconds)
WEBHOOK_TIMEOUT=10
# Maximum delivery attempts before the webhook goes to the dead-letter queue
WEBHOOK_MAX_RETRIES=5
# Base delay between retries (seconds), doubles each attempt
WEBHOOK_BASE_DELAY=300

# --- Rate limiting (requests per window) ------------------------------------
RATE_LIMIT_DEFAULT_RPS=10
RATE_LIMIT_DEFAULT_PER_MIN=300
RATE_LIMIT_DEFAULT_PER_HOUR=5000
RATE_LIMIT_DEFAULT_PER_DAY=100000
RATE_LIMIT_DEFAULT_PER_MONTH=2000000

# --- OTP --------------------------------------------------------------------
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5