[Unit]
Description=HttpSMS - Celery beat scheduler (requeue/expiry/offline/reports)
After=network-online.target
Wants=network-online.target

[Service]
User=httpsms
Group=httpsms
WorkingDirectory=/srv/http_sms
EnvironmentFile=/srv/http_sms/.env
ExecStart=/srv/http_sms/venv/bin/celery -A httpsms beat -l info
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target