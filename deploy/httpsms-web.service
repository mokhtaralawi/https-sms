[Unit]
Description=HttpSMS - Django/Daphne web server (HTTP + WebSocket for gateway devices)
After=network-online.target
Wants=network-online.target

[Service]
User=httpsms
Group=httpsms
WorkingDirectory=/srv/http_sms
EnvironmentFile=/srv/http_sms/.env
ExecStart=/srv/http_sms/venv/bin/daphne -b 127.0.0.1 -p 8000 httpsms.asgi:application
Restart=always
RestartSec=3
KillSignal=SIGQUIT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target